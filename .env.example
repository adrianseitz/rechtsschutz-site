# ─────────────────────────────────────────────────────────────
# Kopieren nach .env.local (lokal) bzw. als Umgebungsvariablen beim Hoster setzen.
# ─────────────────────────────────────────────────────────────

# ── Website ──
NEXT_PUBLIC_SITE_URL=https://www.deine-domain.de
NEXT_PUBLIC_BRAND_NAME=Seitz Rechtsschutz
NEXT_PUBLIC_BRAND_SHORT=Seitz
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Optional: externer Buchungslink (z. B. Calendly). Leer = Terminanfrage über /kontakt
NEXT_PUBLIC_BOOKING_URL=

# ── Lead-Speicherung (mindestens ein Ziel muss aktiv sein) ──
# "file" = verschlüsselte NDJSON-Dateien auf dem Server (VPS/Docker mit dauerhaftem Speicher)
# "none" = keine Dateispeicherung (z. B. Vercel) → dann CRM_WEBHOOK_URL und/oder SMTP nutzen
LEAD_STORAGE=file
LEAD_STORAGE_DIR=./data
# 32 Byte, base64. Erzeugen:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LEAD_ENCRYPTION_KEY=
# Zufälliger String für das Hashen von IP-Adressen (Rate Limiting)
LEAD_HASH_SALT=

# ── Geschützter Lead-Export: GET /api/admin/leads?format=csv (mind. 24 Zeichen) ──
ADMIN_TOKEN=

# ── E-Mail-Benachrichtigung bei neuem Lead (optional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Website <noreply@deine-domain.de>"
LEAD_NOTIFY_TO=

# ── CRM-Schnittstelle (optional): z. B. Zapier „Catch Hook“ → Pipedrive ──
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ── Schutz ──
# Zusätzlich erlaubte Origins (kommagetrennt), z. B. Vorschau-Domains
ALLOWED_ORIGINS=
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# ── Tracking (wird nur nach Einwilligung geladen) ──
# Variante A: Google Tag Manager → alle Tags im Container pflegen, die Felder darunter leer lassen
NEXT_PUBLIC_GTM_ID=
# Variante B: Direkt-Einbindung ohne GTM
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_APPOINTMENT_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

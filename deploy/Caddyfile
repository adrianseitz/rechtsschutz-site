# Hauptadresse: www.<DOMAIN>, die Adresse ohne www leitet dorthin weiter.
{$DOMAIN} {
	redir https://www.{$DOMAIN}{uri} permanent
}

www.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# Zweite Domain (im-rechtsschutz.de): zeigt dieselbe Website unter eigener Adresse, ohne www leitet auf www weiter.
# Google bekommt über die Canonical-Angaben weiterhin seitz-rechtsschutz.de als Hauptadresse (kein doppelter Inhalt).
{$DOMAIN2:im-rechtsschutz.de} {
	redir https://www.{$DOMAIN2:im-rechtsschutz.de}{uri} permanent
}

www.{$DOMAIN2:im-rechtsschutz.de} {
	encode zstd gzip
	reverse_proxy app:3000
}
